import React from 'react';

/**
 * FaceMeasurements — Displays facial measurement data in a table with reference ranges.
 */

export default function FaceMeasurements({ measurements }) {
    if (!measurements || Object.keys(measurements).length === 0) return null;

    const thirds = measurements.facial_thirds;

    return (
        <div className="p-4 space-y-4">
            <table className="w-full text-sm">
                <thead>
                    <tr className="text-gray-500 border-b border-gray-800">
                        <th className="text-left py-2 px-3">Measurement</th>
                        <th className="text-right py-2 px-3">Value</th>
                        <th className="text-right py-2 px-3">Reference</th>
                    </tr>
                </thead>
                <tbody>
                    {Object.entries(measurements).map(([key, data]) => {
                        if (!data || typeof data !== 'object' || !('value' in data)) return null;
                        return (
                            <tr key={key} className="border-b border-gray-800/50 hover:bg-gray-800/30">
                                <td className="py-2 px-3 text-gray-300 capitalize">
                                    {key.replace(/_/g, ' ')}
                                </td>
                                <td className="py-2 px-3 text-right font-mono text-white">
                                    {data.value} {data.unit === 'degrees' ? '°' : data.unit}
                                </td>
                                <td className="py-2 px-3 text-right text-gray-500 text-xs">
                                    {data.reference || '—'}
                                </td>
                            </tr>
                        );
                    })}
                </tbody>
            </table>

            {/* Facial Thirds Visualization */}
            {thirds && (
                <div className="mt-4">
                    <h4 className="text-xs font-semibold text-gray-500 mb-2">Facial Thirds Balance</h4>
                    <div className="flex gap-1 h-6">
                        <div
                            className="bg-indigo-600 rounded-l-md flex items-center justify-center text-xs"
                            style={{ width: `${thirds.upper}%` }}
                        >
                            {thirds.upper?.toFixed(1)}%
                        </div>
                        <div
                            className="bg-purple-600 flex items-center justify-center text-xs"
                            style={{ width: `${thirds.middle}%` }}
                        >
                            {thirds.middle?.toFixed(1)}%
                        </div>
                        <div
                            className="bg-pink-600 rounded-r-md flex items-center justify-center text-xs"
                            style={{ width: `${thirds.lower}%` }}
                        >
                            {thirds.lower?.toFixed(1)}%
                        </div>
                    </div>
                    <div className="flex justify-between text-xs text-gray-500 mt-1">
                        <span>Upper</span>
                        <span>Middle</span>
                        <span>Lower</span>
                    </div>
                    <p className="text-xs text-gray-600 mt-1">Ideal: 33.3% each</p>
                </div>
            )}
        </div>
    );
}
